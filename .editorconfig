# EditorConfig — https://editorconfig.org
# Convenções de indentação/encoding já praticadas no repo, agora explícitas para
# qualquer editor: ruff (apps/api) usa 4 espaços; apps/web e apps/desktop, 2.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf
