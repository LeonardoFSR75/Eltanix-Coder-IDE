# URL do backend FastAPI. Usada apenas no servidor Next (nunca exposta ao browser).
ELTANIX_API_URL=http://127.0.0.1:8000
# Mesma chave de ELTANIX_API_KEY do backend.
ELTANIX_API_KEY=troque-me

# Porta do Next. Descomente se a 3000 já estiver ocupada — no Windows com
# Docker Desktop, o proxy do WSL costuma reservar 3000 e 8000 para containers
# de outros projetos, e a colisão aparece como EADDRINUSE ou como uma página
# de outro app respondendo no lugar desta.
# PORT=3010
