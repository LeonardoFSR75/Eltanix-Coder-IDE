meta {
  name: Change Password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/change-password
  body: json
  auth: none
}

headers {
  Cookie: sicoobito_session={{sessionToken}}
}

body:json {
  {
    "old_password": "troque-me",
    "new_password": "nova-senha-aqui"
  }
}

docs {
  Revoga toda outra sessão ativa do usuário, exceto a que fez a troca
  (ver auth/service.py::change_password) — um token de sessão vazado
  para de funcionar assim que a senha muda.
}
