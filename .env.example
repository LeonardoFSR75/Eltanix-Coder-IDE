# ─── Núcleo ────────────────────────────────────────────────────────────────
# Segredos: NÃO deixe os valores "troque-me" — gere um aleatório para cada um
# antes do primeiro boot (o startup aborta com ELTANIX_API_KEY vazia):
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
#
# Chave do canal de serviço (CI/cline/continue/aider/cursor). Poder total,
# estática, sem rotação (é o desenho do ADR 0005) — trate como raiz.
ELTANIX_API_KEY=troque-me
ELTANIX_LOG_LEVEL=INFO
ELTANIX_LOG_JSON=false

# Cifra em repouso do segredo TOTP do 2º fator (F-7). Opcional: sem ela o
# segredo fica em claro no banco (aceitável no modelo local-first, mas o
# startup avisa se houver MFA configurado). Se definir, use a MESMA chave
# sempre — trocá-la torna os segredos TOTP existentes indecifráveis.
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
ELTANIX_MFA_SECRET_KEY=

# Login do browser (/ide, ADR 0005) — separado da chave acima, que é o canal
# de serviço (CI/cline/continue/aider/cursor). Sem ELTANIX_ADMIN_PASSWORD
# fixada, a API gera uma senha aleatória na primeira subida e só a mostra uma
# vez, no log (docker compose logs api | grep auth.seed_user) — fixe antes do
# primeiro `docker compose up` para não perdê-la.
ELTANIX_ADMIN_USERNAME=admin
ELTANIX_ADMIN_PASSWORD=troque-me-antes-do-primeiro-boot

# ─── Projetos ──────────────────────────────────────────────────────────────
# Pasta do HOST que contém os projetos editáveis. Cada subdiretório vira um
# projeto no seletor do IDE. Esta é a fronteira: nada fora dela é alcançável.
PROJECTS_ROOT=/caminho/absoluto/para/seus/projetos

# ─── Portas (faixa 5400–5499, para não disputar 3000/8000/5432) ────────────
#   5400 web · 5401 api · 5402 executor · 5403 postgres · 5404 redis
# Definidas no docker-compose.yml; alterá-las lá basta.

# URL da API vista pelo BROWSER. Usada apenas para montar a URL do WebSocket,
# que o browser abre direto — o resto passa pelo proxy do Next.
PUBLIC_API_ORIGIN=http://localhost:5401

# ─── Executor ──────────────────────────────────────────────────────────────
# Único serviço com acesso ao daemon do Docker. Este token é o que impede
# qualquer outro container da rede de criar sandboxes.
EXECUTOR_TOKEN=troque-me-tambem

# ─── Sandbox do agente ─────────────────────────────────────────────────────
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_MEMORY=2g
SANDBOX_TIMEOUT_SECONDS=300
# Rede desligada por padrão. Ligar permite ao container falar com a internet —
# faça isso apenas conscientemente.
SANDBOX_NETWORK=false
# Teto de sandboxes ativos ao mesmo tempo neste host/executor — sessão além
# disso espera numa fila local (FIFO) em vez de competir por CPU/memória.
SANDBOX_MAX_CONCURRENT=6

# ─── Contexto / indexação ──────────────────────────────────────────────────
# Dimensão do embedding. Mudar exige nova migração (o índice HNSW é de dimensão
# fixa). 768 = nomic-embed-text.
EMBEDDING_DIM=768
EMBEDDING_PROFILE=embedding
EMBEDDING_BATCH_SIZE=32

# ADR 0017. `validate_catalog` já desabilita na carga o modelo de embedding
# cuja `embedding_dim` (providers.yaml) não bate com EMBEDDING_DIM acima.
# Ligado, o boot também falha em vez de subir sem RAG — o que se quer em
# produção, e não numa IDE local que nem usa aquele provedor.
ELTANIX_CATALOG_STRICT=false

# Vizinhos que o índice HNSW percorre por busca. O default do pgvector (40) é
# menor que o pool de candidatos (50) da fusão RRF, o que trunca a metade
# vetorial. Mais alto = mais recall e mais latência; medir com
# `uv run eltanix-eval-rag` antes de mexer (ADR 0018).
HNSW_EF_SEARCH=100

# Reaper que reindexa workspaces com arquivo pendente de embedding (o modelo
# estava fora do ar quando ele foi indexado). 0 desliga.
EMBEDDING_BACKFILL_INTERVAL_SECONDS=1800

# Prefixos assimétricos de embedding (`search_query:` / `search_document:`),
# declarados por modelo em providers.yaml. ADR 0019 §6.
# ATENÇÃO: ligar MUDA O ESPAÇO VETORIAL. A troca é segura — a etiqueta de
# proveniência vira `<modelo>#prefixed` e o filtro do ADR 0017 tira os vetores
# antigos do ramo vetorial sozinho — mas até reindexar tudo a busca cai para as
# pernas lexicais. Rollout em dois passos: ligar, depois reindexar.
EMBEDDING_PREFIXES_ENABLED=false

# ─── Camada de recuperação (`retrieval/`, ADR 0019) ────────────────────────
# Kill switch: desligada, `search_code` volta ao `IndexerService.search` de
# sempre, que continua existindo justamente para isso.
RETRIEVAL_ENABLED=true

# Candidatos pedidos a cada fonte antes da fusão, e quantos deles entram na
# chamada do reranker. Pool do tamanho do resultado final transforma rerank e
# MMR em no-op.
RETRIEVAL_CANDIDATE_POOL=50
RETRIEVAL_RERANK_CANDIDATES=40
# O reranker devolve `limit × isto` para o MMR ter o que diversificar.
RETRIEVAL_OVERSAMPLE=3

# Rerank listwise (uma chamada barata no perfil utility sobre os candidatos).
# Maior ganho de precisão da camada; desligar volta à ordem da fusão.
RETRIEVAL_RERANK_ENABLED=true

# Expansão multi-query. Só dispara em pergunta curta e SEM identificador citado
# (`retrieval/query.py::should_expand`), então ligada ela não cobra latência da
# busca típica do agente, que cita nome de símbolo.
RETRIEVAL_EXPANSION_ENABLED=true
RETRIEVAL_MAX_VARIANTS=3

# HyDE: embute um documento hipotético em vez da pergunta. Paga uma chamada em
# TODA busca (não tem heurística de porta como a expansão) e o ganho depende do
# corpus — ligar é decisão medida pelo `eltanix-eval-rag`.
RETRIEVAL_HYDE_ENABLED=false

# Quais fontes a política pode consultar além do código.
RETRIEVAL_DOCUMENTS_ENABLED=true
RETRIEVAL_NOTES_ENABLED=true

# Perfil (não modelo) usado por expansão, HyDE e rerank — ADR 0001.
RETRIEVAL_UTILITY_PROFILE=utility

# Orçamento do bloco de contexto. É o corte real: `limit` só limita a contagem.
RETRIEVAL_TOKEN_BUDGET=6000

# λ do MMR: 1.0 = só relevância (MMR vira no-op), 0.0 = só diversidade.
RETRIEVAL_MMR_LAMBDA=0.7

# Pesos das pernas dentro de cada fonte (vão para o SQL dos stores) e `k` do
# RRF. São os parâmetros que as evals afinam — medir com `eltanix-eval-rag`
# antes de mexer, e comparar com `eltanix-eval-gate` (ADR 0018).
RETRIEVAL_WEIGHT_VECTOR=1.0
RETRIEVAL_WEIGHT_TEXT=1.0
RETRIEVAL_WEIGHT_TRIGRAM=0.5
RETRIEVAL_RRF_K=60

# Peso de cada fonte na fusão entre fontes. Código pesa mais numa IDE: a
# pergunta quase sempre é sobre o repositório aberto.
RETRIEVAL_SOURCE_WEIGHT_CONTEXT=1.0
RETRIEVAL_SOURCE_WEIGHT_DOCUMENTS=0.7
RETRIEVAL_SOURCE_WEIGHT_NOTES=0.7

# Autocompletar inline / ghost text (Onda 1.1, ADR 0014). Kill switch + qual
# perfil de rota responde (padrão `completion` em routes.yaml, ordenado por
# latência com modelo local à frente) + teto de chamadas por ator por minuto.
IDE_INLINE_COMPLETIONS_ENABLED=true
IDE_COMPLETION_PROFILE=completion
IDE_COMPLETION_MAX_PER_MINUTE=120

# Predição do próximo edit / "tab to jump" (Onda 1.2, ADR 0015). Kill switch +
# perfil de rota (padrão `next-edit`: mais capaz que o completion, mais rápido
# que o coding) + teto por ator por minuto (dispara por edição assentada).
IDE_NEXT_EDIT_ENABLED=true
IDE_NEXT_EDIT_PROFILE=next-edit
IDE_NEXT_EDIT_MAX_PER_MINUTE=40

# Roteamento automático de skills (Fase 1 do upgrade do agente): similaridade
# de cosseno mínima (0..1) para uma skill entrar no system prompt, e quantas
# no máximo. Ajuste olhando o log `skills.routing.near_miss`.
AGENT_SKILL_ROUTING_MIN_SCORE=0.72
AGENT_SKILL_ROUTING_TOP_K=2

# ─── Roteamento ────────────────────────────────────────────────────────────
DEFAULT_ROUTE_PROFILE=auto
# Orçamento (USD). 0 = sem limite. HARD_STOP bloqueia requests ao estourar.
BUDGET_DAILY_USD=0
BUDGET_MONTHLY_USD=0
BUDGET_HARD_STOP=false

# ─── Cache ─────────────────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
# Só cacheia requisições determinísticas (temperature 0). Desligar isto faz
# respostas criativas virarem repetição silenciosa.
CACHE_ONLY_DETERMINISTIC=true

# ─── Compressão de contexto ────────────────────────────────────────────────
COMPRESSION_ENABLED=true
# Desligue para medir: comparar o custo com e sem roteamento por complexidade é
# a única forma de saber se ele está ajudando no seu uso.
COMPLEXITY_ROUTING_ENABLED=true

# ─── Ollama (local) ────────────────────────────────────────────────────────
# O Ollama é um serviço do compose. Aponte para http://host.docker.internal:11434
# apenas se preferir usar uma instalação já existente no host.
OLLAMA_BASE_URL=http://ollama:11434

# Modelos baixados na primeira subida, separados por espaço. Nesta máquina (sem
# GPU, 16 GB) o 7b roda, mas devagar: se a espera incomodar, remova-o da lista e
# troque os perfis de `routes.yaml` para o 1.5b.
OLLAMA_PULL_MODELS=nomic-embed-text qwen2.5-coder:1.5b qwen2.5-coder:7b
# Tempo que o modelo fica residente em RAM entre requisições.
OLLAMA_KEEP_ALIVE=30m

# ─── Azure AI Foundry ──────────────────────────────────────────────────────
# Deployments gerenciados (azure/<deployment>)
AZURE_API_BASE=
AZURE_API_KEY=
AZURE_API_VERSION=2024-10-21
# Endpoints serverless / MaaS (azure_ai/<modelo>)
AZURE_AI_API_BASE=
AZURE_AI_API_KEY=
# Alternativa a API key: autenticação AAD (az login / managed identity)
AZURE_USE_ENTRA_ID=false

# ─── Databricks Model Serving ──────────────────────────────────────────────
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# ─── Provedores diretos (opcionais, para comparação) ───────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ─── GitHub ────────────────────────────────────────────────────────────────
# Se vazio, o backend tenta obter o token do `gh auth token`.
GITHUB_TOKEN=

# ─── Firecrawl (Web Scraping, Crawling e Search para RAG e Agente) ────────
# Obtenha uma chave em https://www.firecrawl.dev ou aponte para uma instância self-hosted
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev

# ─── Observabilidade (Langfuse) ───────────────────────────────────────────
# Opcional: permite rastreamento em tempo real do LangGraph e chamadas de LLM.
# Se vazio ou LANGFUSE_ENABLED=false, o sistema utiliza apenas a telemetria interna no Postgres.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=true

# ─── MinIO (blob storage dos documentos do RAG) ────────────────────────────
# ATENÇÃO DE SEGURANÇA: As credenciais default abaixo (minioadmin) devem ser
# alteradas antes de qualquer implantação em redes não isoladas.
# minio:9000 dentro do compose; localhost:5407 é a porta publicada no host,
# usada em URLs pré-assinadas que o browser precisa alcançar.
MINIO_ENDPOINT=localhost:5407
MINIO_PUBLIC_ENDPOINT=localhost:5407
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_DOCUMENTS_BUCKET=eltanix-documents

# ─── Documentos (RAG) ───────────────────────────────────────────────────────
DOCUMENTS_MAX_UPLOAD_MB=25
DOCUMENTS_CHUNK_TOKENS=512
DOCUMENTS_CHUNK_OVERLAP_TOKENS=64

# ─── Segurança (SecureBERT) ────────────────────────────────────────────────
# Ativa o modelo neural real HuggingFace (ehsanaghaei/SecureBERT, ~500 MB)
# no Docker ou ambiente com extra `securebert` instalado.
# Se false/vazio, o sistema usa o analisador heurístico veloz sem carregar pesos.
SECUREBERT_MODEL_ENABLED=true
