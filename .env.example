# ─── Núcleo ────────────────────────────────────────────────────────────────
# Chave única de acesso local. Gere com: python -c "import secrets;print(secrets.token_urlsafe(32))"
SICOOBITO_API_KEY=troque-me
SICOOBITO_LOG_LEVEL=INFO
SICOOBITO_LOG_JSON=false

# ─── Infra ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sicoobito:sicoobito@localhost:5433/sicoobito
REDIS_URL=redis://localhost:6380/0

# ─── Roteamento ────────────────────────────────────────────────────────────
# Perfil usado quando o cliente não especifica um modelo conhecido.
DEFAULT_ROUTE_PROFILE=auto
# Orçamento (USD). 0 = sem limite. HARD_STOP bloqueia requests ao estourar.
BUDGET_DAILY_USD=0
BUDGET_MONTHLY_USD=0
BUDGET_HARD_STOP=false

# ─── Cache ─────────────────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
# Só cacheia requisições determinísticas (temperature 0). Desligar isto faz
# respostas criativas virarem repetição silenciosa.
CACHE_ONLY_DETERMINISTIC=true

# ─── Ollama (local) ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ─── Azure AI Foundry ──────────────────────────────────────────────────────
# Deployments gerenciados (azure/<deployment>)
AZURE_API_BASE=https://SEU-RECURSO.openai.azure.com
AZURE_API_KEY=
AZURE_API_VERSION=2024-10-21
# Endpoints serverless / MaaS (azure_ai/<modelo>)
AZURE_AI_API_BASE=
AZURE_AI_API_KEY=
# Alternativa a API key: autenticação AAD (az login / managed identity)
AZURE_USE_ENTRA_ID=false

# ─── Databricks Model Serving ──────────────────────────────────────────────
DATABRICKS_HOST=https://SEU-WORKSPACE.cloud.databricks.com
DATABRICKS_TOKEN=

# ─── Provedores diretos (opcionais, para comparação) ───────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── GitHub ────────────────────────────────────────────────────────────────
# Se vazio, o backend tenta obter o token do `gh auth token`.
GITHUB_TOKEN=
